#include <Adafruit_GFX.h>
#include <Adafruit_ST7735.h>
#include <SPI.h>
#include "images.h"   // generated by make_images_h.py (keep in this folder)

#define TFT_SCK  2   // SCL
#define TFT_MOSI 4   // SDA
#define TFT_RST  0
#define TFT_DC   1
#define TFT_CS   5

#define SLIDE_MS 5000

Adafruit_ST7735 tft(&SPI, TFT_CS, TFT_DC, TFT_RST);

void setup() {
  SPI.begin(TFT_SCK, -1, TFT_MOSI, TFT_CS);
  tft.initR(INITR_BLACKTAB);   // try INITR_GREENTAB / INITR_REDTAB if edges look off
  tft.setRotation(1);          // landscape 160x128
  tft.fillScreen(ST77XX_BLACK);
}

void loop() {
  for (int i = 0; i < NUM_IMAGES; i++) {
    tft.drawRGBBitmap(0, 0, images[i], IMG_W, IMG_H);
    delay(SLIDE_MS);
  }
}